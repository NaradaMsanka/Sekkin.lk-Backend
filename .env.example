# PostgreSQL setup. Spring Boot does not automatically load .env files.
# Set these in the hosting environment or your IDE run configuration.
# For the temporary local submission demo, run start-demo.ps1 instead.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cosmetic_db
SPRING_DATASOURCE_USERNAME=replace-with-database-user
SPRING_DATASOURCE_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-bytes
PORT=8080
JPA_DDL_AUTO=validate
CHECKOUT_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional image uploads; credentials stay on the backend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional local-admin-bootstrap Spring profile only. No default admin is created.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Password recovery: backend runtime only. Never add SMTP_PASSWORD to Vite/Vercel frontend env.
# Spring Boot does not load this file automatically; Compose forwards the variables below.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_FRONTEND_URL=https://www.sekkin.lk
PASSWORD_RESET_FROM=no-reply@sekkin.lk
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
